{
  "name": "@acdi/avaldao-feathers",
  "description": "Avaldao Feathers",
  "version": "1.0.1",
  "homepage": "",
  "main": "src",
  "keywords": [
    "feathers"
  ],
  "directories": {
    "lib": "src",
    "test": "test/"
  },
  "engines": {
    "node": ">= 14.0.0"
  },
  "scripts": {
    "test": "npm run eslint && npm run mocha",
    "eslint": "eslint src/. test/.",
    "eslint:fix": "eslint src/. test/. --fix",
    "start": "node ./src/index.js",
    "start:rsk": "NODE_ENV=rsk node ./src/index.js",
    "start:ganache": "NODE_ENV=ganache node ./src/index.js",
    "start:rsk_testnet": "NODE_ENV=rsk_testnet node ./src/index.js",
    "serve": "pm2 startOrRestart ecosystem.config.js --env production",
    "mocha": "mocha test/ --recursive",
    "prettify": "prettier --write 'src/**/*.js*'",
    "reset-db": "node scripts/resetDataBase.js",
    "reset-rsk-db": "node scripts/rsk/resetRSKDataBase.js",
    "mongo": "mongod --fork --syslog"
  },
  "dependencies": {
    "@feathersjs/authentication": "2.1.7",
    "@feathersjs/authentication-jwt": "2.0.1",
    "@feathersjs/configuration": "1.0.2",
    "@feathersjs/errors": "3.3.0",
    "@feathersjs/express": "1.2.3",
    "@feathersjs/feathers": "3.1.7",
    "@feathersjs/socketio": "3.2.2",
    "@pinata/sdk": "^1.1.11",
    "axios": "^1.7.7",
    "compression": "^1.7.0",
    "cors": "^2.8.4",
    "debug": "^3.1.0",
    "dotenv": "^8.2.0",
    "feathers-authentication-hooks": "0.3.0",
    "feathers-hooks-common": "4.14.1",
    "feathers-mongoose": "^8.3.3",
    "helmet": "^3.8.1",
    "lodash.merge": "^4.6.1",
    "lodash.omit": "^4.5.0",
    "lodash.pick": "^4.4.0",
    "mongoose": "^5.13.6",
    "mongoose-long": "^0.3.2",
    "passport-strategy": "^1.0.0",
    "serve-favicon": "^2.4.3",
    "triple-beam": "^1.3.0",
    "web3-eth-accounts": "1.2.11",
    "web3-utils": "1.2.11",
    "winston": "^3.3.3",
    "winston-daily-rotate-file": "^4.5.0"
  },
  "devDependencies": {
    "eslint": "^4.10.0",
    "eslint-config-airbnb-base": "^12.1.0",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-prettier": "^2.4.0",
    "mocha": "^3.5.0",
    "prettier": "^1.9.2"
  }
}
